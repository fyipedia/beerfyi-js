{
  "name": "beerfyi",
  "version": "0.1.0",
  "description": "TypeScript API client for BeerFYI -- beer styles, hops, malts, yeast, and BJCP classifications. Zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "beer",
    "brewery",
    "hops",
    "malt",
    "yeast",
    "bjcp",
    "ipa",
    "lager",
    "ale",
    "craft-beer",
    "beer-style",
    "api-client",
    "beerfyi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fyipedia/beerfyi-js"
  },
  "homepage": "https://beerfyi.com",
  "license": "MIT",
  "author": "FYIPedia",
  "devDependencies": {
    "tsup": "^8.0",
    "typescript": "^5.7",
    "vitest": "^3.0"
  }
}
